\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Measured Damage-Assessment and Cross-Dataset Transfer Results}{18}{subsection.6.2}\protected@file@percent }
\newlabel{sec:results-inference}{{6.2}{18}{Measured Damage-Assessment and Cross-Dataset Transfer Results}{subsection.6.2}{}}
\newlabel{sec:results-inference@cref}{{[subsection][2][6]6.2}{[1][18][]18}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Measured cross-dataset transfer results. Left: cascade (early-exit) accuracy on clean imagery, in-domain versus zero-shot transfer, in both directions between the non-Palu xBD disasters and the Palu, Indonesia tsunami subset. Right: split-conformal prediction-set coverage at a nominal 90 percent target, alongside the error rate restricted to the subset of tiles where the conformal set collapses to a single confident class. Coverage degrades only modestly under transfer, but the error rate among confident single-class predictions rises sharply, from 9.7 percent in-domain to 38.8 percent under non-Palu-to-Palu transfer, meaning the model's raw confidence becomes substantially less trustworthy under distribution shift even though the calibrated set-valued guarantee survives close to its target level.}}{19}{figure.caption.7}\protected@file@percent }
\newlabel{fig:transfer}{{3}{19}{Measured cross-dataset transfer results. Left: cascade (early-exit) accuracy on clean imagery, in-domain versus zero-shot transfer, in both directions between the non-Palu xBD disasters and the Palu, Indonesia tsunami subset. Right: split-conformal prediction-set coverage at a nominal 90 percent target, alongside the error rate restricted to the subset of tiles where the conformal set collapses to a single confident class. Coverage degrades only modestly under transfer, but the error rate among confident single-class predictions rises sharply, from 9.7 percent in-domain to 38.8 percent under non-Palu-to-Palu transfer, meaning the model's raw confidence becomes substantially less trustworthy under distribution shift even though the calibrated set-valued guarantee survives close to its target level}{figure.caption.7}{}}
\newlabel{fig:transfer@cref}{{[figure][3][]3}{[1][19][]19}{}{}{}}
\citation{teerapittayanon2016branchynet}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Measured risk-coverage curves. The full early-exit-plus-conformal configuration (triangles) achieves the lowest selective risk at high coverage in-domain, confirming the benefit of the design described in Section~\ref {sec:methods}, but this advantage narrows under cross-domain transfer and under corruption severity 3, where all three configurations converge toward comparable risk at most coverage levels. At the extreme coverage end on the transfer domain, the small number of tiles that remain in the conformal set at the tightest significance level becomes a source of real sampling noise rather than a precise estimate, which we flag explicitly rather than smoothing over.}}{20}{figure.caption.8}\protected@file@percent }
\newlabel{fig:riskcoverage}{{4}{20}{Measured risk-coverage curves. The full early-exit-plus-conformal configuration (triangles) achieves the lowest selective risk at high coverage in-domain, confirming the benefit of the design described in Section~\ref {sec:methods}, but this advantage narrows under cross-domain transfer and under corruption severity 3, where all three configurations converge toward comparable risk at most coverage levels. At the extreme coverage end on the transfer domain, the small number of tiles that remain in the conformal set at the tightest significance level becomes a source of real sampling noise rather than a precise estimate, which we flag explicitly rather than smoothing over}{figure.caption.8}{}}
\newlabel{fig:riskcoverage@cref}{{[figure][4][]4}{[1][20][]20}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Figure A. Co-simulator connectivity-restoration trajectory $\Phi (t)$, AeroMesh (solid) against the no-self-healing ablation (dashed), for each scenario at each of the three failure-process severities. The step shape in the AeroMesh curves reflects the declared four-epoch recovery schedule described above, not a continuously measured ns-3 trace; the levels at each step are real bootstrap-resampled ns-3 and AODV packet delivery ratios. In the Indonesia and Vietnam scenarios the no-self-healing ablation starts and remains above the AeroMesh trajectory, the same measured pattern already reported as a genuine civilian-class weakness in Section~\ref {sec:results-network}, surfacing here in a different form rather than being smoothed away by the coupling layer.}}{21}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cosimphit}{{5}{21}{Figure A. Co-simulator connectivity-restoration trajectory $\Phi (t)$, AeroMesh (solid) against the no-self-healing ablation (dashed), for each scenario at each of the three failure-process severities. The step shape in the AeroMesh curves reflects the declared four-epoch recovery schedule described above, not a continuously measured ns-3 trace; the levels at each step are real bootstrap-resampled ns-3 and AODV packet delivery ratios. In the Indonesia and Vietnam scenarios the no-self-healing ablation starts and remains above the AeroMesh trajectory, the same measured pattern already reported as a genuine civilian-class weakness in Section~\ref {sec:results-network}, surfacing here in a different form rather than being smoothed away by the coupling layer}{figure.caption.9}{}}
\newlabel{fig:cosimphit@cref}{{[figure][5][]5}{[1][21][]21}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Figure B. Joint connectivity-assessment frontier from the co-simulator, mean priority-weighted connectivity $\Phi $ against mean assessment value $\Psi $ normalized to AeroMesh's own mean, across all three hundred fifteen scenario-failure-process-replicate-ablation runs; large markers are per-ablation means. Under this reduced-fidelity role-coupling model, AeroMesh's full configuration does not dominate the fixed-roles or oracle-controller ablations on this frontier, both of which retain more assessment throughput at comparable or higher connectivity; Table~\ref {tab:cosimablation} reports this numerically with significance tests.}}{22}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cosimpareto}{{6}{22}{Figure B. Joint connectivity-assessment frontier from the co-simulator, mean priority-weighted connectivity $\Phi $ against mean assessment value $\Psi $ normalized to AeroMesh's own mean, across all three hundred fifteen scenario-failure-process-replicate-ablation runs; large markers are per-ablation means. Under this reduced-fidelity role-coupling model, AeroMesh's full configuration does not dominate the fixed-roles or oracle-controller ablations on this frontier, both of which retain more assessment throughput at comparable or higher connectivity; Table~\ref {tab:cosimablation} reports this numerically with significance tests}{figure.caption.10}{}}
\newlabel{fig:cosimpareto@cref}{{[figure][6][]6}{[1][21][]22}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Co-simulator time-to-restore per priority class, defined as the first epoch at which that class's connectivity reaches ninety percent of AeroMesh's own real measured failure-process-zero level for the same scenario, averaged across the nine scenario-failure-process cells and five replicates per cell. ``Not restored'' counts replicates that never cross the threshold within the three-hundred-second mission horizon.}}{22}{table.caption.11}\protected@file@percent }
\newlabel{tab:cosimrestore}{{5}{22}{Co-simulator time-to-restore per priority class, defined as the first epoch at which that class's connectivity reaches ninety percent of AeroMesh's own real measured failure-process-zero level for the same scenario, averaged across the nine scenario-failure-process cells and five replicates per cell. ``Not restored'' counts replicates that never cross the threshold within the three-hundred-second mission horizon}{table.caption.11}{}}
\newlabel{tab:cosimrestore@cref}{{[table][5][]5}{[1][22][]22}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Co-simulator six-ablation comparison against AeroMesh's full configuration, paired by scenario, failure-process severity, and replicate ($n=45$ paired observations per ablation), using the composite score defined as the unweighted mean of mean connectivity $\Phi $ and mean assessment value $\Psi $ normalized to AeroMesh's own $\Psi $. Positive mean difference favors AeroMesh's full configuration. Confidence intervals are from a paired bootstrap with ten thousand resamples; $p$-values are Wilcoxon signed-rank, Holm-Bonferroni-corrected across the six-ablation family; Cliff's delta is the paired rank effect size.}}{23}{table.caption.12}\protected@file@percent }
\newlabel{tab:cosimablation}{{6}{23}{Co-simulator six-ablation comparison against AeroMesh's full configuration, paired by scenario, failure-process severity, and replicate ($n=45$ paired observations per ablation), using the composite score defined as the unweighted mean of mean connectivity $\Phi $ and mean assessment value $\Psi $ normalized to AeroMesh's own $\Psi $. Positive mean difference favors AeroMesh's full configuration. Confidence intervals are from a paired bootstrap with ten thousand resamples; $p$-values are Wilcoxon signed-rank, Holm-Bonferroni-corrected across the six-ablation family; Cliff's delta is the paired rank effect size}{table.caption.12}{}}
\newlabel{tab:cosimablation@cref}{{[table][6][]6}{[1][23][]23}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}A real joint ns-3 check for the Philippines scenario}{23}{subsection.6.3}\protected@file@percent }
\newlabel{sec:results-joint-real}{{6.3}{23}{A real joint ns-3 check for the Philippines scenario}{subsection.6.3}{}}
\newlabel{sec:results-joint-real@cref}{{[subsection][3][6]6.3}{[1][23][]23}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Real joint ns-3 check, Philippines scenario only. (a) Directly measured, time-resolved priority-weighted connectivity $\Phi (t)$, full AeroMesh configuration against the no-self-healing ablation, across the three failure-process severities; both configurations converge to full connectivity within one to three epochs in this scenario's base simulated area, and self-healing's measured benefit here is small and inconsistent in direction rather than the clear advantage the co-simulator's broader scenario mix shows. (b) Real paired comparison of AeroMesh's full auctioned configuration against the fixed-roles ablation ($n=9$ paired failure-severity-seed observations), using the same composite score as Table~\ref {tab:cosimablation}; fixed roles scores higher than the full configuration, Cliff's $\delta =-0.59$, Wilcoxon $p=0.031$ uncorrected.}}{24}{figure.caption.13}\protected@file@percent }
\newlabel{fig:jointvalidate}{{7}{24}{Real joint ns-3 check, Philippines scenario only. (a) Directly measured, time-resolved priority-weighted connectivity $\Phi (t)$, full AeroMesh configuration against the no-self-healing ablation, across the three failure-process severities; both configurations converge to full connectivity within one to three epochs in this scenario's base simulated area, and self-healing's measured benefit here is small and inconsistent in direction rather than the clear advantage the co-simulator's broader scenario mix shows. (b) Real paired comparison of AeroMesh's full auctioned configuration against the fixed-roles ablation ($n=9$ paired failure-severity-seed observations), using the same composite score as Table~\ref {tab:cosimablation}; fixed roles scores higher than the full configuration, Cliff's $\delta =-0.59$, Wilcoxon $p=0.031$ uncorrected}{figure.caption.13}{}}
\newlabel{fig:jointvalidate@cref}{{[figure][7][]7}{[1][24][]24}{}{}{}}
